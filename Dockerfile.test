# Throwaway Linux environment for the integration tests (make integration).
FROM golang:1.26-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 nftables iptables iputils-ping netcat-openbsd procps \
       dnsmasq-base isc-dhcp-client bind9-dnsutils hostapd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
